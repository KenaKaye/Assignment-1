# Large corpus text and archive files
*.txt
*.TXT
*.gz
*.GZ
*.tar.gz
*.zip
*.ZIP
output/data/*.txt
output/data/*.TXT
output/data/*.gz
output/data/GPAC.txt*
output/data/compress.py
output/data/counts/
output/data/*.npy
output/data/sentence_assessment.tsv
output/data/vocab.tsv
data/
Docs/
# Ensure output directory and metadata are tracked
!output/
!output/figures/
!output/figures/*
!output/results/
!output/results/*
!output/data/
output/data/split_indices_*.json
!output/data/artifact_list.json
!output/data/checksums.json
!output/data/manifest.json
!output/data/profile_counts.json
!output/data/README.md
!output/data/.gitkeep

# Large serialized models
*.pkl
*.pickle
!models/
!models/.gitkeep
!models/README.md

# Python & Jupyter cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
scratch/

# Environments & Dependencies
venv/
env/
.env
node_modules/
.next/

# OS generated
Thumbs.db
Desktop.ini
.DS_Store

# Agent instructions
AGENTS.md